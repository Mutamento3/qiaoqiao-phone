{
  "name": "qiaqiao-phone",
  "private": true,
  "version": "1.10.251",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-esbuild.mjs && node scripts/copy-functions.js",
    "build:vite": "vite build && node scripts/copy-functions.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "npm rebuild esbuild || true",
    "prepare": "husky",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=qiaqiao-phone --branch=main"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "localforage": "^1.10.0",
    "marked": "^17.0.1",
    "pinia": "2.1.7",
    "puppeteer-core": "^25.4.0",
    "three": "^0.185.1",
    "tone": "^15.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.26",
    "autoprefixer": "^10.4.23",
    "esbuild-plugin-vue3": "^0.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-vue": "^1.1.6",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vue-eslint-parser": "^9.4.3",
    "wrangler": "^4.113.0"
  }
}
